# ==============================================================================
# SIH26117 Sovereign Agentic AI Workbench — Environment Configurations
# ==============================================================================

# Model Weights Directory
# On RTX 4060 Laptop (Windows): D:\model or D:/model
# On macOS: /Volumes/980/USER/SIH_Agentic_Workbench/models
MODEL_BASE_PATH=D:/model

# GPU Node vLLM Server (NVIDIA GeForce RTX 4060 Laptop on Local LAN or localhost)
# If backend runs directly on the laptop: http://127.0.0.1:8001/v1 (or 8000)
# If backend runs on Mac connecting over LAN: http://<LAPTOP_IP>:8001/v1 (e.g. http://192.168.1.50:8001/v1)
VLLM_API_BASE=http://127.0.0.1:8001/v1
VLLM_API_KEY=EMPTY

# Local Ollama Server (Port 11434)
# On Windows RTX 4060 Laptop: set OLLAMA_MODELS=D:\model
OLLAMA_API_BASE=http://127.0.0.1:11434

# Specialist Model Folders inside D:\model
VISION_MODEL=Qwen2.5-VL-7B-Instruct-AWQ
AUDITOR_MODEL=DeepSeek-R1-Distill-Llama-8B-AWQ
SUPERVISOR_MODEL=Meta-Llama-3.1-8B-Instruct-AWQ-INT4
EMBEDDING_MODEL=bge-m3

# Strict Real Inference (No Fake Simulations)
ALLOW_FALLBACK_SIMULATION=False

